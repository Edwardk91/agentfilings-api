{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "apps/**/src/**/*.ts",
    "packages/**/src/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
