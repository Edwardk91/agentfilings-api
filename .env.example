# FilingsData environment. Copy to `.env` and fill in.
# Eddie provisions these; NEVER hardcode secrets or commit a real .env.

# --- API service ---
PORT=8080

# --- Database (Supabase Postgres) ---
# Use the Supavisor transaction pooler (port 6543), not the direct 5432 connection.
DATABASE_URL=

# --- Cache (Upstash Redis) ---
UPSTASH_REDIS_URL=

# --- x402 (Base USDC) — VERIFIED v2 stack, 2026-07-23 ---
# Receiving address = your external EOA. This is the x402 `payTo`.
# NEVER put a blockchain private key here or anywhere in the repo. Address only.
X402_RECEIVING_ADDRESS=
# CAIP-2 network id. Dev/testnet: eip155:84532 (Base Sepolia). Prod: eip155:8453 (Base mainnet).
X402_NETWORK=eip155:84532
# Facilitator URL.
#   dev  = https://x402.org/facilitator            (keyless, free, Base Sepolia)
#   prod = https://api.cdp.coinbase.com/platform/v2/x402   (Base mainnet; needs the CDP keys below)
X402_FACILITATOR_URL=https://x402.org/facilitator

# --- CDP facilitator keys (MAINNET ONLY) ---
# Created by Eddie in the CDP dashboard. These are CDP *API* keys (JWT auth for the
# facilitator), NOT a blockchain wallet private key. Leave blank for testnet dev.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Stripe (fiat rail — Stage 1) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SEC EDGAR (ingestion) ---
# Required by SEC fair-access policy; embedded in the User-Agent on every request.
# Any real, reachable contact works (no mandated format), e.g. you@example.com.
SEC_CONTACT_EMAIL=
